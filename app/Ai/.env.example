# ==========================================
# AssistIQ AI/ML Service Environment Config
# ==========================================

# Application Settings
APP_NAME="AssistIQ AI Service"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
LOG_LEVEL="INFO"

# LLM Provider Configuration (openai | gemini | grok)
LLM_PROVIDER="openai"

# OpenAI Configuration
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Grok / xAI Configuration
GROK_API_KEY=""
GROK_MODEL="grok-3-mini"

# Embedding Provider Configuration (openai | huggingface)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=""

# Database Configuration (PostgreSQL + pgvector owned by Express backend)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/assistiq"
VECTOR_STORE_TABLE="knowledge_chunks"

# AI Pipeline Config
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
RETRIEVAL_CONFIDENCE_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Redis Cache & Queue Configuration
REDIS_URL="redis://localhost:6379/0"

# Main Backend Service Communication
EXPRESS_BACKEND_URL="http://localhost:5000"
INTERNAL_API_KEY="dev_internal_secret_key"
