# ==========================================
# AssistIQ AI/ML Service Environment Config
# ==========================================

# Application Settings
APP_NAME="AssistIQ AI Service"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
LOG_LEVEL="INFO"

# Log output format: "text" (default) or "json".
# text - the human-readable line, with structured fields as a `key=value` suffix:
#          [2026-10-03 19:39:09] [ERROR] [assistiq_ai] - OpenRouter call failed: AUTH | operation=provider_generate provider=openrouter model_id=openai/gpt-4o-mini kind=AUTH fault=ours provider_status=401
# json - one JSON object per line, for a log collector:
#          {"ts": "2026-10-03 19:39:09", "level": "ERROR", "logger": "assistiq_ai", "msg": "OpenRouter call failed: AUTH", "operation": "provider_generate", ...}
# Provider error text is logged in both, but only after redaction - see app/Ai/README.md.
LOG_FORMAT="text"

# LLM Provider Configuration (openai | gemini | grok)
LLM_PROVIDER="openai"

# OpenAI Configuration
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Grok / xAI Configuration
GROK_API_KEY=""
GROK_MODEL="grok-3-mini"

# ==========================================
# Model catalog providers
# ==========================================
# One block per provider. The rules are the same for all of them:
#
#   * This file is the ONLY place a provider credential lives. The Express backend has no
#     provider variable of any kind: it stores a provider slug and a model id, and this
#     service maps that slug to the key below. No key is ever sent to Node, written to the
#     application database, or returned by an API response — the platform dashboard only
#     ever learns whether one is present, as a boolean.
#   * EMPTY MEANS "ADAPTER AVAILABLE, CREDENTIAL ABSENT", not "provider disabled". The
#     dashboard reports those as two independent badges, so an operator can tell "not
#     wired up yet" from "wired up and broken". Leaving one empty is safe: any model
#     routed to it fails as NOT_CONFIGURED without a network call, and the conversation
#     falls back rather than erroring.
#   * A provider still has to be enabled in the platform dashboard. Configuring a key here
#     does not by itself make a provider selectable.
#
# Enabling a provider and cataloguing its models are separate switches on purpose: see
# app/server/README.md ("AI model catalog").

# ------------------------------------------
# OpenRouter — multi-vendor gateway
# ------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OpenRouter's OpenAI-compatible endpoint. Override only to point at a local proxy or a
# mirror; the default is the production API.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Seconds to wait for a completion. A provider that never answers must not hold a
# conversation open indefinitely — the wait surfaces as a TIMEOUT provider failure, which
# Node turns into a reason-coded fallback.
OPENROUTER_REQUEST_TIMEOUT=30.0

# Optional attribution headers OpenRouter displays on its dashboard. They identify this
# application, never an account, and carry no credential. Sent only when non-empty.
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="AssistIQ"

# ------------------------------------------
# Groq — fast inference on open-weight models
# ------------------------------------------
# NOT TO BE CONFUSED WITH GROK. Groq (groq.com, this block) is an inference provider.
# Grok is xAI's model family, configured above as GROK_API_KEY. Different companies,
# different APIs, different credentials — the names differ by one letter.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
# The HOST, with no `/openai/v1` — unlike every other *_BASE_URL in this file.
# Groq's own SDK already appends `/openai/v1/chat/completions` to whatever base it is
# given, so adding the OpenAI-compatible suffix here produces
# `/openai/v1/openai/v1/chat/completions` and every call 404s.
GROQ_BASE_URL="https://api.groq.com"
GROQ_REQUEST_TIMEOUT=30.0

# ------------------------------------------
# OpenAI — first-party API
# ------------------------------------------
# Deliberately NOT LLM_API_KEY. That variable is generic: it holds whatever LLM_PROVIDER
# points at, so with LLM_PROVIDER="gemini" it holds a Gemini key. Reading it here would
# report the OpenAI provider as configured on the strength of someone else's credential.
# If you have set only LLM_API_KEY, the dashboard will show OpenAI as "credential
# missing" — which is accurate.
#
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_REQUEST_TIMEOUT=30.0

# ------------------------------------------
# Google Gemini
# ------------------------------------------
# GEMINI_API_KEY above is reused here rather than duplicated: it is one credential serving
# two paths (the legacy LLM_PROVIDER path and the catalog adapter). A second variable could
# disagree with the first, and the dashboard would then report Gemini as configured or not
# depending on which one an operator happened to set.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_REQUEST_TIMEOUT=30.0

# ------------------------------------------
# Generic OpenAI-compatible endpoint (one slot)
# ------------------------------------------
# For any service speaking the OpenAI wire protocol that is not one of the four above:
# Together, Fireworks, DeepInfra, a corporate gateway, or a local vLLM / Ollama.
#
# Rather than an adapter per vendor, this is one catalog provider (`openai_compatible`)
# whose endpoint is configuration. Point OPENAI_COMPATIBLE_BASE_URL at the service and
# catalogue whatever model ids it serves from the platform dashboard.
#
# BOTH VALUES ARE REQUIRED for the provider to read as configured. langchain-openai
# demands an api_key value even against a server that ignores it, so a keyless local
# server needs a placeholder — e.g. OPENAI_COMPATIBLE_API_KEY="not-needed". This is
# deliberate: a readiness badge that turned green for an endpoint with no key would be
# hiding a real misconfiguration.
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_REQUEST_TIMEOUT=30.0

# Embedding Provider Configuration (openai | huggingface)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=""

# Vector store (PostgreSQL + pgvector) — its own instance, separate from the application
# database the Express server owns, because the RAG pipeline needs the `vector` extension.
# Start it with `docker compose up -d` (see docker-compose.yml in this directory).
DATABASE_URL="postgresql://postgres:password@localhost:5433/assistiq"
VECTOR_STORE_TABLE="knowledge_chunks"

# Password for the vector-db container above. Must match the password in DATABASE_URL.
# Read by docker compose when starting the service; omitted from .env it falls back to
# "password", which is what DATABASE_URL above uses.
VECTOR_DB_PASSWORD="password"

# AI Pipeline Config
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
RETRIEVAL_CONFIDENCE_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Service-to-Service Authentication
# Shared secret the Node backend must send in the `X-API-Key` header.
# Must match AI_SERVICE_API_KEY in app/server/.env. Every /api/v1 route rejects requests
# without it; when this is empty the service refuses all of them (503) rather than
# accepting unauthenticated traffic. Generate one with: openssl rand -hex 32
AI_SERVICE_API_KEY="replace-with-a-long-random-secret"
