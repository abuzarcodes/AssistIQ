# ==========================================
# AssistIQ AI/ML Service Environment Config
# ==========================================

# Application Settings
APP_NAME="AssistIQ AI Service"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
LOG_LEVEL="INFO"

# LLM Provider Configuration (openai | gemini | grok)
LLM_PROVIDER="openai"

# OpenAI Configuration
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Grok / xAI Configuration
GROK_API_KEY=""
GROK_MODEL="grok-3-mini"

# Embedding Provider Configuration (openai | huggingface)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=""

# Vector store (PostgreSQL + pgvector) — its own instance, separate from the application
# database the Express server owns, because the RAG pipeline needs the `vector` extension.
# Start it with `docker compose up -d` (see docker-compose.yml in this directory).
DATABASE_URL="postgresql://postgres:password@localhost:5433/assistiq"
VECTOR_STORE_TABLE="knowledge_chunks"

# Password for the vector-db container above. Must match the password in DATABASE_URL.
# Read by docker compose when starting the service; omitted from .env it falls back to
# "password", which is what DATABASE_URL above uses.
VECTOR_DB_PASSWORD="password"

# AI Pipeline Config
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
RETRIEVAL_CONFIDENCE_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Service-to-Service Authentication
# Shared secret the Node backend must send in the `X-API-Key` header.
# Must match AI_SERVICE_API_KEY in app/server/.env. Every /api/v1 route rejects requests
# without it; when this is empty the service refuses all of them (503) rather than
# accepting unauthenticated traffic. Generate one with: openssl rand -hex 32
AI_SERVICE_API_KEY="replace-with-a-long-random-secret"
