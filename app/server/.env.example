# ---- Core ----
NODE_ENV=development
PORT=5000

# ---- Database (PostgreSQL via Prisma) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/assistiq_db?schema=public"

# ---- Authentication (JWT) ----
# Use a long random value (min 16 chars). Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ---- AI/ML service boundary ----
# Base URL of the Python FastAPI service.
AI_SERVICE_URL="http://localhost:8000"
# Per-request timeout in milliseconds (uploads use 3x this value).
AI_SERVICE_TIMEOUT="30000"
# Shared secret sent to the Python service in the `X-API-Key` header.
# Must match AI_SERVICE_API_KEY in app/Ai/.env. There is no "disabled" mode: the AI
# service refuses unauthenticated requests, so both sides must be set to the same value.
# Generate one with: openssl rand -hex 32
AI_SERVICE_API_KEY="replace-with-a-long-random-secret"

# ---- RBAC ----
# Email of the account promoted to PLATFORM_OWNER by `npm run db:seed`.
# Register the account first, then run the seed. Leave empty to skip promotion.
PLATFORM_OWNER_EMAIL=""

# ---- CORS ----
# "*" reflects all origins (no credentials). Otherwise a comma-separated allowlist,
# e.g. CORS_ORIGIN="http://localhost:3000,https://app.assistiq.com"
CORS_ORIGIN="*"

# ---- Logging ----
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
